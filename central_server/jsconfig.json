{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2022",
        "checkJs": true,
        "moduleResolution": "nodenext",
        "paths": {
            "#plugins/*": ["./src/plugins*"],
            "#routes/*": ["./src/routes/*"],
            "#schema/*": ["./src/schema/*"],
            "#generated/*": ["./generated/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}

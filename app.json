{
    "expo": {
        "name": "jsExpo",
        "slug": "jsExpo",
        "version": "1.0.0",
        "orientation": "default",
        "icon": "",
        "scheme": "jsexpo",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "splash": {
            "image": "",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "permissions": ["CAMERA"]
        },
        "web": {
            "bundler": "metro",
            "favicon": ""
        },
        "plugins": ["expo-font", "expo-web-browser"],
        "experiments": {
            "typedRoutes": true
        }
    }
}

{
    "extends": "./node_modules/expo/tsconfig.base.json",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./src/assets/*"]
        },
        "jsx": "react-native",
        "checkJs": true
    },
    "include": ["**/*.js", "**/*.jsx", "eslint.config.js"],
    "exclude": ["node_modules", "dist", ".expo", ".expo/types/**/*.js"]
}

{
    "expo": {
        "name": "LCC PriceVer",
        "description": "A product price verifier for LCC SuperMarkets",
        "version": "1.0.0",
        "slug": "lcc-pricever",
        "orientation": "landscape",
        "icon": "./public/app-logo.png",
        "scheme": "lcc-pricever",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "platforms": ["android", "web"],
        "web": {
            "bundler": "metro",
            "favicon": "./public/favicon.ico"
        },
        "plugins": [
            "expo-font",
            "expo-web-browser",
            [
                "expo-splash-screen",
                {
                    "image": "./public/app-logo.png",
                    "imageWidth": 200,
                    "resizeMode": "contain"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "android": {
            "package": "com.snooze33.lccpricever",
            "permissions": [
                "android.permissions.ACCESS_NETWORK_STATE",
                "android.permissions.ACCESS_WIFI_STATE"
            ]
        }
    }
}

{
    "compilerOptions": {
        "strict": true,
        "module": "es2022",
        "types": ["vite/client"],
        "moduleResolution": "Node",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@pages/*": ["./src/pages/*"],
            "@layouts/*": ["./src/components/layouts/*"],
            "@ui/*": ["./src/components/ui/*"],
            "@/assets/*": ["./src/assets/*"]
        },
        "jsx": "react-native",
        "checkJs": true
    },
    "include": ["**/*.js", "**/*.jsx", "eslint.config.js"],
    "exclude": ["node_modules"]
}
